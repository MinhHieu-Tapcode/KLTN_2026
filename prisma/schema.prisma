datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. ENUMS (DANH MỤC TRẠNG THÁI & VAI TRÒ)
// ==========================================

enum RoleCode {
  ADMIN               // Quản trị viên toàn hệ thống
  SCHOOL_MANAGER      // Quản nhiệm trường học
  TEACHER             // Giáo viên giảng dạy
  TEACHING_ASSISTANT  // Trợ giảng (TA)
  STUDENT             // Học viên
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SchoolType {
  THCS
  THPT
  UNIVERSITY
  OTHER
}

enum ClassProgram {
  IELTS
  SAT
  CAMBRIDGE
  OTHER
}

enum ClassStatus {
  UPCOMING  // Sắp khai giảng
  ACTIVE    // Đang diễn ra
  FINISHED  // Đã kết thúc / Lưu trữ lịch sử
  CANCELLED // Đã hủy
}

enum StaffClassRole {
  TEACHER             // Giáo viên phụ trách giảng dạy
  TEACHING_ASSISTANT  // Trợ giảng phụ trách lớp
}

enum StudentEnrollmentStatus {
  STUDYING    // Đang học
  COMPLETED   // Đã hoàn thành khóa học
  DROPPED     // Nghỉ học / Bỏ học
  TRANSFERRED // Chuyển sang lớp khác
}

// ==========================================
// 2. TÀI KHOẢN & NGƯỜI DÙNG (AUTH & USERS)
// ==========================================

model Role {
  id          String    @id @default(uuid())
  code        RoleCode  @unique
  name        String    // Tên tiếng Việt hiển thị
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users       User[]

  @@map("roles")
}

model User {
  id                 String    @id @default(uuid())
  username           String    @unique // Mã học viên hoặc Username đăng nhập
  email              String    @unique // Bắt buộc - Dùng để đăng nhập & nhận thông tin tài khoản
  passwordHash       String
  roleId             String
  mustChangePassword Boolean   @default(true) // Bắt buộc đổi mật khẩu khi đăng nhập lần đầu
  isActive           Boolean   @default(true) // Xóa mềm tài khoản
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Quan hệ
  role               Role                 @relation(fields: [roleId], references: [id])
  profile            UserProfile?
  managedSchools     School[]             // 1 Quản nhiệm có thể quản lý nhiều Trường (1:N)
  classAssignments   ClassAssignment[]    // Danh sách lớp GV/TA được phân công
  classEnrollments   ClassEnrollment[]    // Danh sách lớp Học sinh theo học
  importLogs         ImportLog[]          // Lịch sử các đợt Import Excel
  passwordResetTokens PasswordResetToken[]
  submissions        AssignmentSubmission[]

  @@index([roleId])
  @@index([email])
  @@index([username])
  @@map("users")
}

model UserProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  fullName    String    // Họ và tên
  phoneNumber String?
  dateOfBirth DateTime?
  gender      Gender?
  avatarUrl   String?
  address         String?
  entryIeltsScore Float?    // Điểm IELTS đầu vào
  ieltsLevelId    String?   // Trình độ IELTS được xác định
  extraInfo       Json?     // Mở rộng linh hoạt: Band IELTS, chứng chỉ đối với GV/TA
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ieltsLevel      IeltsLevel? @relation(fields: [ieltsLevelId], references: [id], onDelete: SetNull)

  @@map("user_profiles")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

// ==========================================
// 3. QUẢN LÝ TRƯỜNG HỌC (SCHOOLS)
// ==========================================

model School {
  id           String      @id @default(uuid())
  managerId    String?     // Quản nhiệm phụ trách (Mỗi trường có đúng 1 Quản nhiệm)
  code         String      @unique // Mã trường (VD: THPT_TD, THPT_KL)
  name         String      // Tên trường (VD: THPT Trương Định)
  type         SchoolType  @default(THPT)
  address      String?
  contactName  String?     // Đại diện ban giám hiệu / giáo vụ trường
  contactPhone String?
  isActive     Boolean     @default(true) // Xóa mềm
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  manager      User?       @relation(fields: [managerId], references: [id], onDelete: SetNull)
  classes      Class[]

  @@index([code])
  @@index([managerId])
  @@map("schools")
}

// ==========================================
// 4. QUẢN LÝ LỚP HỌC (CLASSES)
// ==========================================

model Class {
  id          String        @id @default(uuid())
  schoolId    String        // Lớp thuộc trường đối tác nào
  code        String        @unique // Mã lớp IELTS (VD: IELTS_TD_01) - Khớp với file Excel
  name        String        // Tên lớp hiển thị (VD: IELTS Bứt Phá - 10A1)
  program     ClassProgram  @default(IELTS)
  level       String?       // Cấp độ mục tiêu (VD: 5.5 - 6.5, Foundation)
  ieltsLevelId String?      // Trình độ IELTS liên kết
  capacity    Int           @default(30)
  startDate   DateTime?
  endDate     DateTime?
  status      ClassStatus   @default(UPCOMING)
  description String?
  isActive    Boolean       @default(true) // Xóa mềm
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  school      School            @relation(fields: [schoolId], references: [id])
  ieltsLevel  IeltsLevel?       @relation(fields: [ieltsLevelId], references: [id], onDelete: SetNull)
  assignments ClassAssignment[] // Phân công Giáo viên, Trợ giảng
  enrollments ClassEnrollment[] // Danh sách Học sinh theo học
  materialFolders MaterialFolder[]
  classAssignmentsList Assignment[]
  assignmentLinks AssignmentClass[]

  @@index([schoolId])
  @@index([code])
  @@index([status])
  @@map("classes")
}

model ClassAssignment {
  id          String         @id @default(uuid())
  classId     String
  userId      String         // Tài khoản GV hoặc TA
  roleInClass StaffClassRole
  assignedAt  DateTime       @default(now())

  class       Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  staff       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId]) // Một nhân sự không bị gán lặp trong cùng 1 lớp
  @@map("class_assignments")
}

model ClassEnrollment {
  id         String                  @id @default(uuid())
  classId    String
  studentId  String                  // Tài khoản Học sinh
  status     StudentEnrollmentStatus @default(STUDYING)
  enrolledAt DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  class      Class                   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student    User                    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId]) // Một học sinh không bị gán 2 lần vào cùng 1 lớp
  @@map("class_enrollments")
}

// ==========================================
// 5. NHẬT KÝ IMPORT EXCEL HÀNG LOẠT
// ==========================================

model ImportLog {
  id           String   @id @default(uuid())
  importedById String
  fileName     String
  totalRows    Int
  successCount Int
  errorCount   Int
  errorDetails Json?    // Lưu danh sách dòng lỗi để xuất báo cáo
  createdAt    DateTime @default(now())

  importedBy   User     @relation(fields: [importedById], references: [id])

  @@map("import_logs")
}

// ==========================================
// 6. PHÂN QUYỀN ĐỘNG HỆ THỐNG (DYNAMIC RBAC)
// ==========================================

model SystemPermission {
  id           String     @id @default(uuid())
  featureKey   String     @unique // VD: VIEW_USERS, VIEW_SCHOOLS, VIEW_CLASSES, VIEW_SCHEDULE, IMPORT_EXCEL, SYSTEM_SETTINGS
  name         String     // Tên tính năng tiếng Việt
  category     String?    // Nhóm tính năng
  allowedRoles RoleCode[] // Danh sách các vai trò được cấp quyền truy cập
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("system_permissions")
}

// ==========================================
// 7. CẤU HÌNH TRÌNH ĐỘ & PHÂN LỚP IELTS
// ==========================================

model IeltsLevel {
  id               String   @id @default(uuid())
  code             String   @unique // Mã trình độ (VD: BASIC, INTERMEDIATE, ADVANCED)
  name             String   // Tên hiển thị (VD: Cơ bản, Trung bình, Nâng cao)
  minScore         Float    // Điểm IELTS tối thiểu (VD: 0.0, 4.5, 6.5)
  maxScore         Float    // Điểm IELTS tối đa (VD: 4.0, 6.0, 9.0)
  description      String?  // Mô tả trình độ
  targetClassCount Int      @default(1) // Số lớp cấu hình phân bổ khi nhập hàng loạt
  isActive         Boolean  @default(true) // Trạng thái hoạt động
  sortOrder        Int      @default(0) // Thứ tự hiển thị
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  students         UserProfile[]
  classes          Class[]
  materialFolders  MaterialFolder[]

  @@index([minScore, maxScore])
  @@map("ielts_levels")
}

// ==========================================
// 8. MODULE QUẢN LÝ HỌC LIỆU (LEARNING MATERIALS)
// ==========================================

enum MaterialType {
  PDF           // Tài liệu giáo trình, bài đọc PDF
  AUDIO         // File nghe MP3/WAV
  DOCUMENT      // Word DOCX, PPT, Excel
  VIDEO         // Video bài giảng
  OTHER         // Tệp tin khác
}

model MaterialFolder {
  id           String             @id @default(uuid())
  name         String             // Tên thư mục (VD: Buổi 1 - Reading Skills)
  description  String?
  classId      String?            // Gắn với Lớp học cụ thể (Null nếu là Học liệu chung)
  ieltsLevelId String?            // Gắn với Trình độ IELTS chung (Null nếu là Học liệu lớp)
  parentId     String?            // Thư mục cha (hỗ trợ cây thư mục vô hạn cấp)
  createdById  String             // Người tạo (Admin hoặc Giáo viên)
  sortOrder    Int                @default(0)
  isActive     Boolean            @default(true) // Xóa mềm
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  class        Class?             @relation(fields: [classId], references: [id], onDelete: Cascade)
  ieltsLevel   IeltsLevel?        @relation(fields: [ieltsLevelId], references: [id], onDelete: Cascade)
  parent       MaterialFolder?    @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subFolders   MaterialFolder[]   @relation("FolderHierarchy")
  materials    LearningMaterial[]

  @@index([classId])
  @@index([ieltsLevelId])
  @@index([parentId])
  @@map("material_folders")
}

model LearningMaterial {
  id           String         @id @default(uuid())
  folderId     String         // Thuộc thư mục nào
  title        String         // Tên tài liệu hiển thị
  fileUrl      String         // Đường dẫn file (URL hoặc base64/local path)
  fileName     String         // Tên file gốc
  fileSize     Int            // Dung lượng file (bytes)
  fileType     MaterialType   @default(PDF)
  mimeType     String?        // application/pdf, audio/mpeg,...
  uploadedById String         // Người tải lên
  downloadCount Int           @default(0)
  isActive     Boolean        @default(true) // Xóa mềm
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  folder       MaterialFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@map("learning_materials")
}

// ==========================================
// 9. MODULE QUẢN LÝ BÀI TẬP (ASSIGNMENTS & EXAMS)
// ==========================================

enum AssignmentSkill {
  ALL_SKILLS    // Full 4 kỹ năng
  READING       // Kỹ năng Đọc
  LISTENING     // Kỹ năng Nghe
  WRITING       // Kỹ năng Viết
  SPEAKING      // Kỹ năng Nói
}

enum AssignmentType {
  HOMEWORK      // Bài tập về nhà
  QUIZ          // Bài kiểm tra ngắn trên lớp
  MIDTERM       // Thi giữa kỳ
  MOCK_EXAM     // Thi thử IELTS mô phỏng
}

enum QuestionType {
  MULTIPLE_CHOICE // Trắc nghiệm 1 đáp án
  MULTIPLE_SELECT // Trắc nghiệm nhiều đáp án đúng
  FILL_IN_BLANK   // Điền từ / Điền khuyết
  TRUE_FALSE_NG   // Dạng True / False / Not Given
  ESSAY           // Tự luận (Writing Task 1 & 2)
  SPEAKING_RECORD // Ghi âm nói (Speaking Part 1, 2, 3)
}

enum SubmissionStatus {
  NOT_STARTED   // Chưa bắt đầu
  IN_PROGRESS   // Đang làm bài
  SUBMITTED     // Đã nộp, chờ chấm
  GRADED        // Đã chấm điểm hoàn tất
}

model Assignment {
  id                 String               @id @default(uuid())
  classId            String               // Bài tập của lớp học nào
  title              String               // Tiêu đề bài tập (VD: Reading Passage 1 - Mini Test 01)
  description        String?              // Hướng dẫn làm bài
  skill              AssignmentSkill      @default(READING)
  type               AssignmentType       @default(HOMEWORK)
  durationMinutes    Int?                 // Thời lượng làm bài (phút) - Null là không giới hạn
  dueDate            DateTime?            // Hạn chót nộp bài
  maxAttempts        Int                  @default(1) // Số lần được làm bài
  audioUrl           String?              // Bắt buộc đính kèm nếu kỹ năng có Listening
  
  // Cấu hình giám sát chống gian lận
  enableProctoring   Boolean              @default(true) // Bật giám sát chuyển tab
  maxTabSwitches     Int                  @default(3)    // Số lần tối đa trước khi tự thu bài
  
  createdById        String               // Giáo viên hoặc Admin tạo bài
  isActive           Boolean              @default(true) // Xóa mềm
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  class              Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignedClasses    AssignmentClass[]
  questions          AssignmentQuestion[]
  submissions        AssignmentSubmission[]

  @@index([classId])
  @@index([dueDate])
  @@map("assignments")
}

model AssignmentClass {
  id                 String               @id @default(uuid())
  assignmentId       String               // Thuộc bài tập nào (bản gốc)
  classId            String               // Giao cho lớp học nào
  dueDate            DateTime?            // Hạn chót nộp bài riêng của lớp
  startDate          DateTime?            // Thời điểm bắt đầu mở bài cho lớp
  enableProctoring   Boolean              @default(true)
  maxTabSwitches     Int                  @default(3)
  isActive           Boolean              @default(true) // Xóa mềm theo lớp
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  assignment         Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  class              Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions        AssignmentSubmission[]

  @@unique([assignmentId, classId])
  @@index([assignmentId])
  @@index([classId])
  @@map("assignment_classes")
}


model AssignmentQuestion {
  id               String               @id @default(uuid())
  assignmentId     String
  questionNumber   Int                  // Câu số mấy (1, 2, 3,...)
  passageText      String?              // Đoạn văn đọc hiểu / Bối cảnh câu hỏi (nếu có)
  prompt           String               // Đề bài câu hỏi
  type             QuestionType         @default(MULTIPLE_CHOICE)
  points           Float                @default(1.0) // Điểm số của câu
  correctAnswer    String?              // Đáp án đúng (đối với Trắc nghiệm / Điền từ)
  explanation      String?              // Lời giải thích / Giải đề chi tiết
  orderIndex       Int                  @default(0)

  assignment       Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  options          QuestionOption[]
  submissionAnswers SubmissionAnswer[]

  @@index([assignmentId])
  @@index([orderIndex])
  @@map("assignment_questions")
}

model QuestionOption {
  id          String             @id @default(uuid())
  questionId  String
  optionLabel String             // A, B, C, D
  content     String             // Nội dung đáp án
  isCorrect   Boolean            @default(false)

  question    AssignmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

model AssignmentSubmission {
  id                 String             @id @default(uuid())
  assignmentId       String
  studentId          String             // Học sinh thực hiện
  attemptNumber      Int                @default(1)
  startedAt          DateTime           @default(now())
  submittedAt        DateTime?
  status             SubmissionStatus   @default(IN_PROGRESS)
  score              Float?             // Tổng điểm đạt được
  totalPoints        Float?             // Thang điểm tối đa
  teacherFeedback    String?            // Nhận xét tổng thể của giáo viên
  gradedById         String?            // Giáo viên / Trợ giảng chấm điểm

  // Dữ liệu giám sát thi
  tabSwitchCount     Int                @default(0)
  isCheatingFlagged  Boolean            @default(false)
  autoSubmittedReason String?           // Lý do tự nộp: "VIOLATED_TAB_SWITCH_LIMIT", "TIME_EXPIRED"

  classId            String?            // Lớp học cụ thể học sinh nộp bài
  assignmentClassId  String?            // Liên kết bảng nối AssignmentClass
  assignment         Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentClass    AssignmentClass?   @relation(fields: [assignmentClassId], references: [id], onDelete: SetNull)
  student            User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers            SubmissionAnswer[]

  @@unique([assignmentId, studentId, attemptNumber])
  @@index([assignmentId])
  @@index([studentId])
  @@index([classId])
  @@index([assignmentClassId])
  @@map("assignment_submissions")
}

model SubmissionAnswer {
  id             String             @id @default(uuid())
  submissionId   String
  questionId     String
  studentAnswer  String?            // Câu trả lời dạng text / A, B, C / bài luận
  audioUrl       String?            // File ghi âm câu trả lời speaking (nếu có)
  isCorrect      Boolean?           // Kết quả trắc nghiệm tự chấm
  awardedPoints  Float?             // Điểm thực tế đạt được
  teacherComment String?            // Nhận xét chi tiết cho từng câu

  submission     AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question       AssignmentQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([questionId])
  @@map("submission_answers")
}



