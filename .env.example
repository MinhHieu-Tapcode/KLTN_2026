# ==============================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN LMS SIMPACE (MẪU)
# ==============================================================

# 1. KẾT NỐI CƠ SỞ DỮ LIỆU POSTGRESQL (SUPABASE POOLER & DIRECT)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 2. XÁC THỰC PHIÊN ĐĂNG NHẬP (SESSION SECRET)
# Một chuỗi bí mật ngẫu nhiên dùng để mã hóa Cookie Token
AUTH_SECRET="simpace-lms-super-secret-key-2024-change-in-production"

# 3. DỊCH VỤ AI (GROQ CLOUD API)
# Đăng ký miễn phí tại: https://console.groq.com/keys
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 4. DỊCH VỤ AI DỰ PHÒNG (GOOGLE GEMINI API)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 5. KHO LƯU TRỮ TÀI LIỆU & FILE GHI ÂM (SUPABASE STORAGE)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 6. CẤU HÌNH GỬI EMAIL THỰC TẾ (GMAIL SMTP - NODEMAILER)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
